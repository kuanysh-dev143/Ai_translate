import sys
import json
import os
import subprocess
import tempfile

from faster_whisper import WhisperModel
from deep_translator import GoogleTranslator


MODEL_SIZE = "small"
DEVICE = "cpu"
COMPUTE_TYPE = "int8"


print(json.dumps({
    "status": "loading_model",
    "message": "Whisper model loading..."
}), flush=True)


model = WhisperModel(
    MODEL_SIZE,
    device=DEVICE,
    compute_type=COMPUTE_TYPE
)


print(json.dumps({
    "status": "ready",
    "message": "Whisper ready"
}), flush=True)


def convert_to_wav(input_file):

    output_file = os.path.join(
        tempfile.gettempdir(),
        f"qazaqvoice_{os.getpid()}.wav"
    )

    command = [
        "ffmpeg",
        "-y",
        "-i",
        input_file,
        "-vn",
        "-ac",
        "1",
        "-ar",
        "16000",
        "-c:a",
        "pcm_s16le",
        output_file
    ]

    result = subprocess.run(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE
    )

    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.decode(
                errors="ignore"
            )
        )

    return output_file


def translate_text(text, target_lang):

    if not text:
        return ""

    try:

        return GoogleTranslator(
            source="auto",
            target=target_lang
        ).translate(text)

    except Exception as error:

        print(json.dumps({
            "status": "translate_error",
            "error": str(error)
        }, ensure_ascii=False), flush=True)

        return ""


def transcribe(audio_file, target_lang):

    segments, info = model.transcribe(
        audio_file,
        beam_size=5,
        vad_filter=True
    )

    result_segments = []
    full_text = []
    full_translated = []

    for segment in segments:

        text = segment.text.strip()

        if not text:
            continue

        translated = translate_text(
            text,
            target_lang
        )

        result_segments.append({
            "start": round(segment.start, 2),
            "end": round(segment.end, 2),
            "text": text,
            "translated": translated
        })

        full_text.append(text)
        full_translated.append(translated)

        print(json.dumps({
            "status": "transcribing",
            "text": text,
            "translated": translated,
            "start": segment.start,
            "end": segment.end
        }, ensure_ascii=False), flush=True)

    return {
        "language": info.language,
        "language_probability": info.language_probability,
        "target_language": target_lang,
        "text": " ".join(full_text),
        "translated_text": " ".join(full_translated),
        "segments": result_segments
    }


def main():

    if len(sys.argv) < 2:

        print(json.dumps({
            "status": "error",
            "error": "Audio file not specified"
        }), flush=True)

        sys.exit(1)


    input_file = sys.argv[1]

    # Мақсатты тіл: python script.py file.mp4 kk
    target_lang = sys.argv[2] if len(sys.argv) > 2 else "kk"


    if not os.path.exists(input_file):

        print(json.dumps({
            "status": "error",
            "error": "File not found"
        }), flush=True)

        sys.exit(1)


    wav_file = None


    try:

        print(json.dumps({
            "status": "converting",
            "message": "Converting audio..."
        }), flush=True)


        wav_file = convert_to_wav(
            input_file
        )


        print(json.dumps({
            "status": "transcribing",
            "message": "Whisper is listening..."
        }), flush=True)


        result = transcribe(
            wav_file,
            target_lang
        )


        print(json.dumps({
            "status": "completed",
            "result": result
        }, ensure_ascii=False), flush=True)


    except Exception as error:

        print(json.dumps({
            "status": "error",
            "error": str(error)
        }, ensure_ascii=False), flush=True)

        sys.exit(1)


    finally:

        if wav_file and os.path.exists(
            wav_file
        ):

            try:
                os.remove(wav_file)
            except:
                pass


if __name__ == "__main__":
    main()
